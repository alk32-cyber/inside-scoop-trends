# Inside Scoop Trends — environment variables. Copy to .env.local and fill in what you have.
# Never commit real values. All secrets are read server-side only; none are exposed to the browser.

# ---------- Database ----------
# Production: any Postgres 14+ (Neon, Supabase, Vercel Postgres, RDS...). Required on Vercel.
# Leave unset locally to use an embedded PGlite database in ./.data/pglite.
DATABASE_URL=
# PGLITE_DATA_DIR=./.data/pglite
# DATABASE_POOL_MAX=5

# ---------- Data mode ----------
# true = dashboard shows only SIMULATED demo data (npm run demo:seed). false = live data only.
DEMO_MODE=false

# ---------- Providers (see README → Provider setup) ----------
# YouTube Data API v3 key (Google Cloud console → APIs & Services → Credentials).
YOUTUBE_API_KEY=
# Reddit OAuth app ("script" or "web" type) — client id/secret and a descriptive user agent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:inside-scoop-trends:0.1.0 (by /u/your_reddit_username)
# News: NewsAPI.org key and/or comma-separated RSS feeds you are permitted to use.
NEWSAPI_KEY=
NEWS_RSS_FEEDS=
# Google Trends via SerpApi (https://serpapi.com/google-trends-api).
SERPAPI_KEY=

# ---------- AI analysis (optional) ----------
# Claude API key for evidence-grounded topic analysis. Without it, labelled template summaries are used.
ANTHROPIC_API_KEY=
# ANALYSIS_MODEL=claude-opus-5-5
# Voyage AI key for embedding-based topic merging. Without it, deterministic grouping only.
VOYAGE_API_KEY=
# EMBEDDING_MODEL=voyage-3.5

# ---------- Scheduling & budgets ----------
# Shared secret for /api/cron/ingest (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=
# Per-provider collection interval (minutes) and daily request budget. Defaults in src/lib/config.ts.
# YOUTUBE_INTERVAL_MINUTES=180
# YOUTUBE_DAILY_REQUEST_BUDGET=90
# REDDIT_INTERVAL_MINUTES=30
# REDDIT_DAILY_REQUEST_BUDGET=1500
# NEWS_INTERVAL_MINUTES=120
# NEWS_DAILY_REQUEST_BUDGET=90
# GOOGLE_TRENDS_INTERVAL_MINUTES=360
# GOOGLE_TRENDS_DAILY_REQUEST_BUDGET=40
# SCHEDULER_TICK_MINUTES=10

# ---------- Scoring ----------
# Override component weights (renormalized to sum to 1). Use `npm run backtest` before changing.
# SCORING_WEIGHTS={"velocity":0.30,"engagement":0.25,"crossPlatform":0.20,"attention":0.15,"relevance":0.10}
# SCORING_WINDOW_HOURS=24
# Data older than this is labelled stale in the dashboard.
# STALE_AFTER_HOURS=12

# ---------- Access control ----------
# When set, the dashboard and API require HTTP Basic auth with this password (any username).
DASHBOARD_PASSWORD=
# API_RATE_LIMIT_PER_MINUTE=120
# API_CACHE_TTL_MS=30000
